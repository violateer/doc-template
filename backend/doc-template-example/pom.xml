<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.violateer</groupId>
        <artifactId>doc-template-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>
    <artifactId>doc-template-example</artifactId>

    <name>Vio Doc Template :: Example</name>
    <description>示例宿主，不在发布范围内。</description>

    <properties>
        <!-- 示例宿主永远不进 Central 的 bundle；也不为它生成 sources/javadoc，省一轮构建时间 -->
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!--
          依赖的 Starter 版本。默认跟随 reactor（父 POM 的版本），这样
          `mvn -pl doc-template-example -am package` 和 IDE 里跑的都是当前源码。

          部署演示站时要覆盖它，例如 -Ddoc-template.version=0.1.1，并**去掉 -am**：
          reactor 里没有 starter，Maven 才会去中央仓库拉那个正式版本。
          演示站验证的必须是用户实际能拿到的包，不能是本地源码。
        -->
        <doc-template.version>${project.version}</doc-template.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.violateer</groupId>
            <artifactId>doc-template-spring-boot-starter</artifactId>
            <version>${doc-template.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          只在 IDE 里直接跑 example 时需要：那时 classpath 指向 Starter 的 target/classes，
          里面还是未重定位的 net.sf.jsqlparser。跑打包后的 Starter jar 时用不到这行
          （jar 里已内置重定位副本），所以它只属于这个示例工程，不属于发布物。
        -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.9</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>1.39.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                  必须显式绑定 repackage：父 POM 只在 pluginManagement 里管版本，
                  没有像 spring-boot-starter-parent 那样把 repackage 挂到 package 阶段。
                  少了这段，mvn package 出来的就是普通 jar（没有 Main-Class），
                  `java -jar` 报 "no main manifest attribute"。
                -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              发布插件按 reactor 收集产物，maven.deploy.skip 对它不起作用，
              要排除某个模块必须用 skipPublishing（插件自己的开关）。
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
