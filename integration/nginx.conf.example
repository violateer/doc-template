# Add these locations to the existing server block. Keep them before a broad
# SPA fallback location so the document-template requests reach Spring Boot.
location /doc-template/ {
    proxy_pass http://127.0.0.1:8080/doc-template/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location /api/doc-template/ {
    proxy_pass http://127.0.0.1:8080/api/doc-template/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
